# =========================================================================
# Charlotte AI Receptionist — Environment Variables Configuration Template
# =========================================================================

# --- 1. Server Configuration ---
PORT=8080
NODE_ENV=development

# --- 2. Database (PostgreSQL) Configuration ---
DATABASE_URL=postgresql://charlotte_admin:password@localhost:5432/charlotte_db?sslmode=disable
# In-memory session parameters (e.g. for testing)
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- 3. Cryptography & Security ---
JWT_SECRET=charlotte_super_secret_jwt_sign_key_change_me_in_production
JWT_EXPIRY=24h
BCRYPT_SALT_ROUNDS=12

# --- 4. Telecom: Twilio API Configuration ---
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_API_KEY=SKXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_API_SECRET=your_twilio_api_secret_here

# For automated webhooks, we need a public URL (e.g. ngrok tunnel in development)
CHARLOTTE_API_BASE_URL=https://your-ngrok-tunnel-url-here.ngrok-free.app
# Hold music URL played to callers waiting in a transfer conference.
# Defaults to a royalty-free Twilio S3 track. Override with any publicly accessible audio URL.
HOLD_MUSIC_URL=

# --- 5. AI Core: Google Gemini API ---
# Used by the @google/genai SDK for Gemini Live real-time voice streaming.
# Note: integration with @google/adk is planned once ADK supports bidirectional audio.
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Gemini Live voice model used for the real-time receptionist (via @google/genai SDK)
GEMINI_MODEL_NAME=gemini-2.0-flash
GEMINI_VOICE_ID=aoede
