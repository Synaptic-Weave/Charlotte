{
  "name": "charlotte-receptionist",
  "version": "1.0.0",
  "description": "Charlotte — AI-powered virtual receptionist built on Google Agent Development Kit (ADK) and Twilio.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "mikro-orm migration:up"
  },
  "keywords": [
    "google-adk",
    "gemini",
    "twilio",
    "voip",
    "ai-agent",
    "receptionist",
    "saas"
  ],
  "author": "Synaptic Weave",
  "license": "Private",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.8.0",
    "@mikro-orm/cli": "^6.2.8",
    "@mikro-orm/core": "^6.2.8",
    "@mikro-orm/migrations": "^6.2.8",
    "@mikro-orm/postgresql": "^6.2.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "twilio": "^5.0.4",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.6.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
